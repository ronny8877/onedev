{
	"name": "onedev",
	"private": true,
	"version": "0.0.1",
	"type": "module",
	"scripts": {
		"dev": "vite dev",
		"mcp:dev": "wrangler dev --config wrangler.mcp.jsonc",
		"mcp:deploy": "wrangler deploy --config wrangler.mcp.jsonc",
		"mcp:check": "wrangler deploy --dry-run --config wrangler.mcp.jsonc",
		"build": "vite build",
		"preview": "wrangler dev .svelte-kit/cloudflare/_worker.js --port 4173",
		"prepare": "npm run types && svelte-kit sync || echo ''",
		"check": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json",
		"check:watch": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json --watch",
		"format": "prettier --write .",
		"lint": "prettier --check . && eslint .",
		"types": "wrangler types",
		"indexnow": "npx tsx scripts/submit-indexnow.ts"
	},
	"devDependencies": {
		"@eslint/compat": "^2.1.1",
		"@eslint/js": "^10.0.1",
		"@sveltejs/adapter-cloudflare": "^7.2.9",
		"@sveltejs/kit": "^2.70.3",
		"@sveltejs/vite-plugin-svelte": "^7.3.0",
		"@tailwindcss/forms": "^0.5.11",
		"@tailwindcss/typography": "^0.5.20",
		"@tailwindcss/vite": "^4.3.3",
		"@types/js-yaml": "^4.0.9",
		"@types/jsbarcode": "^3.11.4",
		"@types/node": "^26.5.0",
		"@types/zxcvbn": "^4.4.5",
		"daisyui": "^5.7.28",
		"eslint": "^10.10.0",
		"eslint-config-prettier": "^10.1.8",
		"eslint-plugin-svelte": "^3.23.0",
		"globals": "^17.12.0",
		"prettier": "^3.9.6",
		"prettier-plugin-svelte": "^4.1.1",
		"prettier-plugin-tailwindcss": "^0.8.1",
		"svelte": "^5.57.0",
		"svelte-check": "^4.7.6",
		"tailwindcss": "^4.3.3",
		"typescript": "^6.0.3",
		"typescript-eslint": "^8.70.0",
		"vite": "^8.2.2",
		"vite-plugin-devtools-json": "^1.1.0",
		"wrangler": "^4.129.1"
	},
	"dependencies": {
		"@codemirror/lang-html": "^6.4.12",
		"@codemirror/lang-json": "^6.0.2",
		"@codemirror/lang-sql": "^6.10.0",
		"@codemirror/lang-xml": "^6.1.0",
		"@codemirror/language": "^6.12.4",
		"@codemirror/search": "^6.7.2",
		"@codemirror/state": "^6.7.4",
		"@codemirror/view": "^6.43.11",
		"@lezer/highlight": "^1.2.3",
		"@lucide/svelte": "^1.42.0",
		"@modelcontextprotocol/server": "^2.0.0",
		"@zxing/browser": "0.2.1",
		"@zxing/library": "0.23.0",
		"browser-image-compression": "^2.0.2",
		"codemirror": "^6.0.2",
		"croner": "^10.0.1",
		"cronstrue": "^3.24.0",
		"exifr": "^7.1.3",
		"extract-colors": "^4.2.1",
		"gpt-tokenizer": "^4.0.0",
		"jose": "^6.2.12",
		"js-yaml": "^5.4.1",
		"jsbarcode": "^3.12.3",
		"jszip": "^3.10.1",
		"nanoid": "^6.0.1",
