		"qrcode-generator": "^2.0.4",
		"shiki": "^4.4.3",
		"sql-formatter": "^15.8.2",
		"svelte-codemirror-editor": "^2.1.0",
		"ulid": "^3.0.2",
		"uuid": "^14.0.2",
		"zod": "^4.5.4",
		"zxcvbn": "^4.4.2"
	}
}
